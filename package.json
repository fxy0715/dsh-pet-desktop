{
  "name": "@local/dsh-pet-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hosts the official DeepSeek whale on the whole desktop, outside the app window.",
  "scripts": {
    "build": "node scripts/build.cjs"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "whale.ps1",
    "ScreenBoundWindow.cs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
