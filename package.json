{
  "name": "@local/dsh-pet-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Windows desktop whale plugin for DeepSeek Harness with gentle roaming, drag-and-drop positioning, click interactions and lifecycle cleanup.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "windows",
    "powershell",
    "wpf"
  ],
  "homepage": "https://github.com/fxy0715/dsh-pet-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxy0715/dsh-pet-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/fxy0715/dsh-pet-desktop/issues"
  },
  "scripts": {
    "build": "node scripts/build.cjs"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "whale.ps1",
    "ScreenBoundWindow.cs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
